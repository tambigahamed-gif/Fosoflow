# Frontend: variables publiques, projet Supabase utilisé côté client
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Mettre true seulement si le fournisseur Google OAuth est configuré dans Supabase Auth
VITE_GOOGLE_OAUTH_ENABLED=false

# API Vercel uniquement (ne jamais préfixer ces variables avec VITE_)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_SECRET
SASPAY_API_KEY=sk_test_REPLACE_WITH_MERCHANT_TEST_KEY
# À renseigner uniquement après création/rotation du webhook dans le dashboard SasPay.
# Le signing_secret n'est affiché qu'une seule fois. Ne jamais mettre cette clé côté navigateur.
# SASPAY_WEBHOOK_SIGNING_SECRET=PASTE_THE_SECRET_FROM_SASPAY_DASHBOARD

# FasoFlow Intelligence — facultatif, côté serveur uniquement ; laisser commenté sans fournisseur configuré.
# FASOFLOW_AI_PROVIDER=openai-compatible
# FASOFLOW_AI_API_KEY=YOUR_AI_PROVIDER_SECRET
# FASOFLOW_AI_MODEL=YOUR_APPROVED_MODEL
# FASOFLOW_AI_BASE_URL=https://api.example.com/v1
