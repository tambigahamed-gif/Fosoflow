# Frontend: variables publiques, projet Supabase utilisé côté client
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Mettre true seulement si le fournisseur Google OAuth est configuré dans Supabase Auth
VITE_GOOGLE_OAUTH_ENABLED=false

# API Vercel uniquement (ne jamais préfixer ces variables avec VITE_)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_SECRET
SASPAY_API_KEY=sk_test_REPLACE_WITH_MERCHANT_TEST_KEY
# Pas encore déclarée: confirmer le header, l'algorithme et la chaîne de signature webhook directement avec SasPay.
# Ne pas renseigner une valeur déduite ou inventée.
